{
  "name": "sam",
  "version": "0.1.0",
  "description": "sam — Simple answer me with html：纸张主题讲义页，无工具栏/运行时；保留 STE 与展示组件。",
  "type": "module",
  "bin": {
    "sam": "bin/sam.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "examples",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "css": "node bin/sam.js css -o docs/paper.css",
    "check": "node scripts/check-sam.mjs",
    "test:kv": "node scripts/test-kv-layout.mjs",
    "test:agent-cases": "node scripts/test-agent-cases.mjs"
  },
  "keywords": [
    "llm",
    "agent",
    "skill",
    "html",
    "explainer",
    "ste100",
    "paper"
  ],
  "license": "MIT",
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "marked": "^18.0.14",
    "temml": "^0.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CannonPanda/sam.git"
  },
  "homepage": "https://github.com/CannonPanda/sam#readme",
  "bugs": {
    "url": "https://github.com/CannonPanda/sam/issues"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
